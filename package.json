{
  "name": "conjumaster-uk",
  "version": "2.0.0",
  "description": "Application web interactive pour apprendre et réviser la conjugaison de l'anglais britannique",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,json,md}\""
  },
  "keywords": [
    "english",
    "conjugation",
    "learning",
    "education",
    "british-english"
  ],
  "author": "Kouakam Henry",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "terser": "^5.46.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
